# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# PostgreSQL connection string.
#
# These credentials match docker-compose.yml at the repository root, so if you
# start the database with "npm run db:up" this line works unchanged.
#
# Use 127.0.0.1, NOT localhost. Prisma's query engine resolves "localhost" to
# the IPv6 address ::1 first, and a container publishing on 0.0.0.0 does not
# answer there. You get "P1001: Can't reach database server" even though the
# port is open. 127.0.0.1 avoids the whole problem.
#
# If port 5432 is already taken by another project, start the database with
# EATME_DB_PORT=5433 npm run db:up   and change the port here to match.
DATABASE_URL="postgresql://eatme:eatme_dev_password@127.0.0.1:5432/eatme?schema=public"

# Port the API listens on. The mobile app's EXPO_PUBLIC_API_URL must match.
PORT=5000

# Node environment: development or production.
NODE_ENV=development

# Secret used to sign JWTs. Generate a long random string, do not use this one.
# For example:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_characters

# How long an issued token stays valid.
JWT_EXPIRES_IN=7d

# Comma separated list of allowed CORS origins, or * during development.
CORS_ORIGIN=*
