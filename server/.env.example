# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# PostgreSQL connection string.
# A default local install listens on 5432 with the superuser "postgres".
# Create the database first:  createdb eatme     (or CREATE DATABASE eatme;)
#
# The ?schema=public suffix is what Prisma expects.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eatme?schema=public"

# Port the API listens on. The mobile app's EXPO_PUBLIC_API_URL must match.
PORT=5000

# Node environment: development or production.
NODE_ENV=development

# Secret used to sign JWTs. Generate a long random string, do not use this one.
# For example:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_characters

# How long an issued token stays valid.
JWT_EXPIRES_IN=7d

# Comma separated list of allowed CORS origins, or * during development.
CORS_ORIGIN=*
