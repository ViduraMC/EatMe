# Production settings for the API on Google Cloud Run. Nothing here is
# committed with real values: DATABASE_URL and JWT_SECRET live in Google Secret
# Manager, the rest are plain service settings. RELEASE.md walks through each.

NODE_ENV=production

# Neon connection string (Secret Manager: eatme-database-url). Must use SSL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Cloud Run sets PORT itself (8080).
# PORT=8080

# Long random secret (Secret Manager: eatme-jwt-secret). Create one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production with the placeholder value.
JWT_SECRET=

JWT_EXPIRES_IN=7d

# The Android app does not need CORS. "*" in production means no browser
# origin is allowed. List origins here only if a web front end is added.
CORS_ORIGIN=*

# Number of proxies in front of the API. Check it after the first deploy
# (RELEASE.md step 5); wrong values break the sign-in rate limit.
TRUST_PROXY_HOPS=1

# Only for the one-off "npm run admin:create" run from your laptop.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PHONE=
# ADMIN_PASSWORD=
