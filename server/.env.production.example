# Production settings for the hosted API. These are entered in the host's
# dashboard (Render → eatme-api → Environment), never committed. RELEASE.md
# walks through each one.

NODE_ENV=production

# Managed PostgreSQL connection string. Must use SSL.
# Neon example (copy the real one from the Neon dashboard):
DATABASE_URL="postgresql://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/eatme?sslmode=require"

# Render sets PORT itself. Only needed on a host that does not.
# PORT=5000

# Long random secret. Render generates one from render.yaml; elsewhere create
# one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production with the placeholder value.
JWT_SECRET=

JWT_EXPIRES_IN=7d

# The Android app does not need CORS. "*" in production means no browser
# origin is allowed. List origins here only if a web front end is added.
CORS_ORIGIN=*

# Number of proxies in front of the API on the host. Wrong values break the
# sign-in rate limit. Check it as described in RELEASE.md step 3.
TRUST_PROXY_HOPS=1

# Only for the one-off "npm run admin:create" that creates the first admin.
# Set them in the shell when you run it, not as permanent service variables.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PHONE=
# ADMIN_PASSWORD=
