# Copy this file to .env and set your laptop's LAN IP address.
# .env is gitignored and must never be committed.
#
# It MUST NOT be localhost or 127.0.0.1. The app runs on a physical phone, and
# "localhost" there means the phone itself, not your laptop.
#
# Find your address:
#   Windows        ipconfig          look for IPv4 Address
#   macOS / Linux  ifconfig          look for inet on your Wi-Fi adapter
#
# The API prints the exact line to paste here when you run "npm run dev:server".
# The phone and the laptop must be on the same Wi-Fi network.

EXPO_PUBLIC_API_URL=http://192.168.1.11:5000/api
